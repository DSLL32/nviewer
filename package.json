{
  "name": "nviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run build && npm run docs:build",
    "build:single": "tsc --noEmit && tsx tools/bundle.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:layers": "tsx tools/layeraudit.ts",
    "check:transfer": "tsx tools/transfer.ts",
    "check:hashes": "tsx tools/hashall.ts",
    "check:render": "tsx tools/render/selftest.ts",
    "check:zelda-source": "tsx tools/zelda-source.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
